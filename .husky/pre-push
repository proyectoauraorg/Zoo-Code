#!/usr/bin/env sh
# =============================================================================
# PRE-PUSH HOOK — Husky-managed
# =============================================================================
# Upstream guard logic is read from main:scripts/upstream-guard.sh so every
# branch carrying THIS hook runs the same up-to-date guard.
# NOTE: protection is per-branch — Husky runs the working-tree copy of this
# hook, which only exists on main/develop. Policy: push to `upstream` ONLY
# from develop/main. (The .git/hooks/pre-push copy from install-hooks.sh does
# NOT run because core.hooksPath=.husky/_.)

guard_tmp="$(mktemp 2>/dev/null || echo "/tmp/upstream-guard.$$")"
if git show main:scripts/upstream-guard.sh > "$guard_tmp" 2>/dev/null && [ -s "$guard_tmp" ]; then
  # Run the guard with git's pre-push stdin (the ref lines) intact. Do NOT pipe
  # the script via `sh -s` — that replaces stdin, so the guard's `while read`
  # sees nothing and silently allows the push.
  sh "$guard_tmp" "$@"
  guard_exit=$?
  rm -f "$guard_tmp"
  if [ "$guard_exit" -ne 0 ]; then
    exit "$guard_exit"
  fi
else
  rm -f "$guard_tmp"
fi

branch="$(git rev-parse --abbrev-ref HEAD)"

if [ "$branch" = "main" ]; then
  echo "You can't push directly to main - please check out a branch."
  exit 1
fi

if [ "$OS" = "Windows_NT" ]; then
  pnpm_cmd="pnpm.cmd"
else
  if command -v pnpm >/dev/null 2>&1; then
    pnpm_cmd="pnpm"
  else
    pnpm_cmd="npx pnpm"
  fi
fi

$pnpm_cmd run check-types

if [ -f ".env.local" ]; then
  if npx dotenvx get RUN_TESTS_ON_PUSH -f .env.local 2>/dev/null | grep -q "^true$"; then
    npx dotenvx run -f .env.local -- $pnpm_cmd run test
  fi
else
  if [ "$RUN_TESTS_ON_PUSH" = "true" ]; then
    $pnpm_cmd run test
  fi
fi

NEW_CHANGESETS=$(find .changeset -name "*.md" ! -name "README.md" | wc -l | tr -d ' ')
echo "Changeset files: $NEW_CHANGESETS"

if [ "$NEW_CHANGESETS" = "0" ]; then
  echo "-------------------------------------------------------------------------------------"
  echo "Changes detected. Please run 'pnpm changeset' to create a changeset if applicable."
  echo "-------------------------------------------------------------------------------------"
fi
