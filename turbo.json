{
	"$schema": "https://turbo.build/schema.json",
	"tasks": {
		"lint": {},
		"check-types": {},
		"test": {
			"dependsOn": ["@roo-code/types#build"]
		},
		"test:coverage": {
			"dependsOn": ["@roo-code/types#build"],
			"outputs": ["coverage/**"]
		},
		"format": {},
		"clean": {
			"cache": false
		},
		"build": {
			"outputs": ["dist/**", ".next/**"],
			"inputs": ["src/**", "package.json", "tsconfig.json", "tsup.config.ts", "vite.config.ts", "next.config.mjs"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"watch:tsc": {
			"cache": false
		}
	}
}
